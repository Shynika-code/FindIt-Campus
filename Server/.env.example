# MongoDB connection string used by the server and admin seeder
MONGO_URI=mongodb://127.0.0.1:27017/findit-campus

# JWT signing secret for authenticated sessions
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated client URLs allowed to call the API in development
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# Initial administrator account. Do not commit the real Server/.env file.
ADMIN_NAME=FindIt Admin
ADMIN_EMAIL=admin@your-campus.edu
ADMIN_PASSWORD=replace-with-a-strong-password-of-at-least-12-characters
